{
    "name": "jeremykenedy/laravel2step",
    "description": "Laravel 2 Step Authentication Package",
    "keywords": [
        "laravel",
        "2-step verification",
        "verification",
        "authentication",
        "two-factor"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "jeremykenedy",
            "email": "jeremykenedy@gmail.com"
        }
    ],
    "require": {
        "php": "^7.3|^8.0",
        "laravel/framework": "6.*|7.*|8.*|9.*|10.*|11.*|12.*|13.*"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.36|^3.8|^4.0",
        "pestphp/pest-plugin-laravel": "^2.4|^3.2|^4.1"
    },
    "autoload": {
        "psr-4": {
            "jeremykenedy\\laravel2step\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "jeremykenedy\\laravel2step\\Test\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "jeremykenedy\\laravel2step\\Laravel2stepServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --ci",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
